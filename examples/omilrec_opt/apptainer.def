Bootstrap: docker
From: docker.m.daocloud.io/library/almalinux:9

# Runtime for the SimpleEvolution omilrec_opt example. Beyond the base harness
# tools (bash/git/node/claude/gcc/cmake/python), this is the "fat" image that
# carries the full system-library chain JUNO's shared libs (junosw/SNiPER/ROOT
# on the bound /cvmfs) link against but almalinux:9 base does NOT ship, so the
# eval's DLL loads work inside the container.
#
# Package list is the proven one from SimpleLoop's junosw-apptainer.def — each
# entry was a real eval failure:
#   freetype      libfreetype.so.6   dep of libBufferMemMgr.so
#   libSM/libICE  libSM.so.6/ICE.so.6  dep of libDetSimMT (X session mgmt)
#   libX11/libXext/libXmu/libXpm/libXft  the X11 client libs DetSim/Tutorial pull
#   libglvnd-glx libGL.so.1   (NOT mesa-libGL directly; libglvnd-glx provides it)
#   mesa-libGLU   libGLU.so.1
#   libicu        libicudata.so.67 / libicui18n.so.67 / libicuuc.so.67
#   libnsl2       libnsl.so.3   (NOT libnsl — that only provides legacy so.1)
#   time          /usr/bin/time  (GNU time, used by the eval benchmark)
#
# The JUNO toolchain, bench input, and maps stay external: task.yaml binds
# /cvmfs and /data/juno/dingxf read-only into the sandbox.
#
# Build (on a host with Apptainer; unset the outer container's binds first):
#   cd examples/omilrec_opt && env -u APPTAINER_BIND -u SINGULARITY_BIND \
#       apptainer build --fakeroot apptainer.sif apptainer.def

%post
    set -eux
    dnf install -y \
        bash ca-certificates diffutils findutils git time \
        freetype \
        libSM libICE libX11 libXext libXmu libXpm libXft \
        libglvnd-glx mesa-libGLU libicu libnsl2 \
        gcc gcc-c++ make cmake patch procps-ng which \
        python3 python3-pip python-unversioned-command tar xz
    curl -fsSLO https://nodejs.org/dist/v22.19.0/node-v22.19.0-linux-x64.tar.xz
    tar -xJf node-v22.19.0-linux-x64.tar.xz -C /usr/local --strip-components=1
    rm -f node-v22.19.0-linux-x64.tar.xz
    python3 -m pip install --no-cache-dir pytest
    # Install pytest for the CVMFS Python 3.11 (J26.1.1) the eval actually
    # invokes. It is pure-Python, so install it into a staging dir with the
    # container's python3 and export that dir on PYTHONPATH below; JUNO's setup
    # prepends (does not overwrite) PYTHONPATH, so the injected dir survives.
    mkdir -p /usr/local/lib/cvmfs_python311_extra
    python3 -m pip install --no-cache-dir --target /usr/local/lib/cvmfs_python311_extra pytest
    npm install -g @anthropic-ai/claude-code@2.1.216
    dnf clean all
    rm -rf /var/cache/dnf

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    # pytest (pure-Python) installed into this dir at build time; prepend so it
    # stays importable by the CVMFS python 3.11 after JUNO setup reshuffles
    # PYTHONPATH (which prepends its own entries, so this survives).
    export PYTHONPATH=/usr/local/lib/cvmfs_python311_extra${PYTHONPATH:+:$PYTHONPATH}

%test
    set -e
    for t in bash git gcc make cmake node claude python3 time; do
        command -v "$t" >/dev/null
    done
    # pytest must resolve for the CVMFS python3.11 the eval uses.
    PYTHONPATH=/usr/local/lib/cvmfs_python311_extra python3 -c "import pytest; print('pytest', pytest.__version__)"
    printf 'int main(){return 0;}\n' | gcc -x c -fopenmp -o /tmp/omilrec_omp_test - && /tmp/omilrec_omp_test
